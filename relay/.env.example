# Copy values into repo-root .env or export in your shell.
# Never commit real keys.

GROQ_API_KEY=
RELAY_DRAFT_MODEL=openai/gpt-oss-120b
RELAY_SMALL_MODEL=openai/gpt-oss-20b

# Low-consumption / degrade ladder engages only at or above this usage fraction.
RELAY_BUDGET_DEGRADE_THRESHOLD=0.80

# Placeholder limits — replace after probing the real free tier.
RELAY_LIMIT_RPM=30
RELAY_LIMIT_TPM=6000
RELAY_LIMIT_RPD=1000
RELAY_LIMIT_TPD=200000
RELAY_LIMIT_IN_FLIGHT=5
