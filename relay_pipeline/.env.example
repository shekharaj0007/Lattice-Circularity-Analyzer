# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting Configuration
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=14400
GROQ_DAILY_TOKEN_LIMIT=14400
BUDGET_THRESHOLD=0.8

# Model Configuration - Strategic Model Sizing
# Default model (fallback)
GROQ_MODEL=gemma2-9b-it

# Stage-specific models for optimal cost/quality tradeoff
# Small/fast models for simple tasks (intent, verification)
GROQ_INTENT_MODEL=gemma2-9b-it
GROQ_VERIFICATION_MODEL=gemma2-9b-it

# Large/capable model for generation (the hard task)
GROQ_GENERATION_MODEL=llama-3.1-70b-versatile

# Alternative model options (Groq free tier):
# Small/fast: gemma-7b-it, gemma2-9b-it
# Large/capable: llama-3.1-70b-versatile, llama-3.3-70b-versatile, mixtral-8x7b-32768

# Local embeddings (no API calls)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pipeline Configuration
MAX_RETRIES=1
CHUNK_SIZE_AGGRESSIVE=256
CHUNK_SIZE_BALANCED=512
CHUNK_SIZE_MINIMAL=1024
TOP_K_AGGRESSIVE=10
TOP_K_BALANCED=5
TOP_K_MINIMAL=3
